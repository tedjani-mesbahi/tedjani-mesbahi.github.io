---
import Profile from './home/Profile.astro';
import NewsSection from './home/NewsSection.astro';
import ResearchSection from './home/ResearchSection.astro';
import PublicationsSection from './home/PublicationsSection.astro';
import BlogSection from './home/BlogSection.astro';
import TeamSection from './home/TeamSection.astro';
import AboutSection from './home/AboutSection.astro';
import TeachingSection from './home/TeachingSection.astro';
import GallerySection from './home/GallerySection.astro';
import PositionsSection from './home/PositionsSection.astro';
import { getSections, getNews } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const sections = getSections().filter((s) => s.visible);
const allNews = getNews();
// Slider: featured news plus the most recent news that have a photo.
const slides = [...allNews.filter((n) => n.featured), ...allNews.filter((n) => n.image && !n.featured)]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);
// The gallery skips photos already shown in the slider.
const usedImages = slides.map((n) => n.image).filter(Boolean);
const titleOf = (sec: any) => (lang === 'fr' ? sec.title_fr : sec.title_en) || sec.title_fr || sec.id;
const components: Record<string, any> = {
  research: ResearchSection,
  publications: PublicationsSection,
  blog: BlogSection,
  team: TeamSection,
  about: AboutSection,
  teaching: TeachingSection,
  positions: PositionsSection,
};
---
<Profile lang={lang} />
{sections.map((sec, i) => {
  const alt = i % 2 === 0;
  if (sec.id === 'news') return <NewsSection lang={lang} title={titleOf(sec)} slides={slides} alt={alt} />;
  if (sec.id === 'gallery') return <GallerySection lang={lang} title={titleOf(sec)} exclude={usedImages} alt={alt} />;
  const Component = components[sec.id];
  return Component ? <Component lang={lang} title={titleOf(sec)} alt={alt} /> : null;
})}
