---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { t, pick, href, formatDate, type Lang } from '../../lib/i18n';
import { getUpdates } from '../../lib/content';

interface Props { lang: Lang; title: string; alt?: boolean }
const { lang, title, alt } = Astro.props;
const s = t(lang);
const updates = getUpdates();
const first = updates.slice(0, 8);
const rest = updates.slice(8);
const icons: Record<string, string> = {
  attending: 'calendar', talk: 'mic', accepted: 'check', published: 'doc', award: 'award', defended: 'cap',
  joined: 'users', recruiting: 'users', media: 'tv', lab: 'flask', project: 'rocket', visit: 'pin', other: 'bulb',
};
const linkOf = (u: any) => (!u.link ? '' : /^https?:/.test(u.link) ? u.link : href(lang, u.link));
---
{updates.length > 0 && (
  <Section id="updates" title={title} intro={s.updates_intro} alt={alt}>
    <ul class="updates">
      {first.map((u) => (
        <li class="update" data-kind={u.kind}>
          <time class="num" datetime={u.date}>{formatDate(u.date, lang, 'short')}</time>
          <span class="update__kind"><Icon name={icons[u.kind] || 'bulb'} />{s.kinds[u.kind] || s.kinds.other}</span>
          <p class="update__text">{linkOf(u) ? <a href={linkOf(u)} rel={/^https?:/.test(u.link) ? 'noopener' : undefined}>{pick(u, 'text', lang)}</a> : pick(u, 'text', lang)}</p>
        </li>
      ))}
    </ul>
    {rest.length > 0 && (
      <details class="updates-more">
        <summary>{s.show_more} <span class="num">({rest.length})</span></summary>
        <ul class="updates">
          {rest.map((u) => (
            <li class="update" data-kind={u.kind}>
              <time class="num" datetime={u.date}>{formatDate(u.date, lang, 'short')}</time>
              <span class="update__kind"><Icon name={icons[u.kind] || 'bulb'} />{s.kinds[u.kind] || s.kinds.other}</span>
              <p class="update__text">{linkOf(u) ? <a href={linkOf(u)} rel={/^https?:/.test(u.link) ? 'noopener' : undefined}>{pick(u, 'text', lang)}</a> : pick(u, 'text', lang)}</p>
            </li>
          ))}
        </ul>
      </details>
    )}
  </Section>
)}
