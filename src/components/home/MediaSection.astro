---
import Section from '../Section.astro';
import { t, pick, href, formatDate, type Lang } from '../../lib/i18n';
import { getNews } from '../../lib/content';

interface Props { lang: Lang; title: string; alt?: boolean }
const { lang, title, alt } = Astro.props;
const s = t(lang);
const items = getNews().filter((n) => n.category === 'media' || n.category === 'outreach').slice(0, 6);
---
{items.length > 0 && (
  <Section id="media" title={title} intro={s.in_media} alt={alt}>
    <ul class="media-list">
      {items.map((n) => (
        <li class="media-item">
          <p class="media-item__outlet">{n.outlet || n.source}</p>
          <h3><a href={href(lang, `news/${n.slug}/`)}>{pick(n, 'title', lang)}</a></h3>
          <time class="num" datetime={n.date}>{formatDate(n.date, lang)}</time>
        </li>
      ))}
    </ul>
  </Section>
)}
