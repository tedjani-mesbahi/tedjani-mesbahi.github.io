---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { t, pick, type Lang } from '../../lib/i18n';
import { getSite } from '../../lib/content';

interface Props { lang: Lang; title: string; alt?: boolean }
const { lang, title, alt } = Astro.props;
const s = t(lang);
const site = getSite();
const links: { label: string; url: string }[] = (site.links || []).filter((l: any) => l?.url);
---
<Section id="contact" title={title} alt={alt}>
  <div class="contact-grid">
    <ul class="contact-list">
      {site.email && (
        <li><span class="ic"><Icon name="email" /></span><span><span class="label">{s.email}</span><a class="value" href={`mailto:${site.email}`}>{site.email}</a></span></li>
      )}
      {site.phone && (
        <li><span class="ic"><Icon name="phone" /></span><span><span class="label">{s.phone}</span><a class="value" href={`tel:${String(site.phone).replace(/\s+/g, '')}`}>{site.phone}</a></span></li>
      )}
      {pick(site, 'address', lang) && (
        <li><span class="ic"><Icon name="pin" /></span><span><span class="label">{s.address}</span><span class="value">{pick(site, 'address', lang)}</span></span></li>
      )}
      {site.office && (
        <li><span class="ic"><Icon name="building" /></span><span><span class="label">{s.office}</span><span class="value">{site.office}</span></span></li>
      )}
    </ul>
    {links.length > 0 && (
      <div>
        <h3 class="profiles-title">{s.profiles}</h3>
        <ul class="profiles-list">
          {links.map((l) => <li><a href={l.url} rel="noopener me"><Icon name="external" />{l.label}</a></li>)}
        </ul>
      </div>
    )}
  </div>
</Section>
