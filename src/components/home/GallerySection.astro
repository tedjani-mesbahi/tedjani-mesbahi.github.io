---
import Section from '../Section.astro';
import Filmstrip from '../Filmstrip.astro';
import { t, type Lang } from '../../lib/i18n';
import { getGallery } from '../../lib/content';

interface Props { lang: Lang; title: string; exclude?: string[]; alt?: boolean }
const { lang, title, exclude = [], alt } = Astro.props;
const s = t(lang);
const all = getGallery();
const rest = all.filter((g) => !exclude.includes(g.image));
const items = rest.length >= 3 ? rest : all;
---
{items.length > 0 && (
  <Section id="gallery" title={title} intro={s.gallery_intro} alt={alt}>
    <Filmstrip lang={lang} items={items} />
  </Section>
)}
