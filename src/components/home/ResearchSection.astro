---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { t, pick, type Lang } from '../../lib/i18n';
import { getResearch, getProjects } from '../../lib/content';

interface Props { lang: Lang; title: string; alt?: boolean }
const { lang, title, alt } = Astro.props;
const s = t(lang);
const research = getResearch();
const themes: any[] = research.themes || [];
const facilities = pick(research, 'facilities', lang);
const projects = getProjects();
---
<Section id="research" title={title} intro={pick(research, 'intro', lang)} alt={alt}>
  <ul class="themes">
    {themes.map((theme) => (
      <li class="theme">
        <span class="theme__icon"><Icon name={theme.icon || 'bulb'} /></span>
        <div>
          <h3>{pick(theme, 'title', lang)}</h3>
          <p>{pick(theme, 'text', lang)}</p>
          {theme.keywords?.length > 0 && (
            <ul class="theme__keys" aria-label={s.keywords}>
              {theme.keywords.map((k: string) => <li class="tag tag--plain">{k}</li>)}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>

  {projects.length > 0 && (
    <div class="subsection" id="projects">
      <h3 class="subsection__title">{s.projects_title}</h3>
      <div class="projects">
        {projects.map((p) => (
          <article class="project" aria-labelledby={`project-${p.slug}`}>
            <h4 class="project__name" id={`project-${p.slug}`}>{p.name}</h4>
            <div class="project__meta">
              <span class="tag">{pick(p, 'role', lang)}</span>
              {pick(p, 'period', lang) && <span class="tag tag--plain num">{pick(p, 'period', lang)}</span>}
            </div>
            <p class="project__title">{pick(p, 'title', lang)}</p>
            <p class="project__summary">{pick(p, 'summary', lang)}</p>
            <dl class="project__facts">
              {pick(p, 'programme', lang) && <><dt>{s.programme}</dt><dd>{pick(p, 'programme', lang)}</dd></>}
              {p.budget && <><dt>{s.budget}</dt><dd class="num">{p.budget}</dd></>}
              {pick(p, 'partners', lang) && <><dt>{s.partners}</dt><dd>{pick(p, 'partners', lang)}</dd></>}
            </dl>
            {p.link && <a class="more" href={p.link} rel="noopener">{s.details}</a>}
          </article>
        ))}
      </div>
    </div>
  )}

  {facilities && (
    <div class="facility">
      <Icon name="flask" />
      <p><strong>{s.facilities}</strong>{facilities}</p>
    </div>
  )}
</Section>
