---
interface Props { id: string; title: string; intro?: string; moreHref?: string; moreLabel?: string; alt?: boolean }
const { id, title, intro, moreHref, moreLabel, alt = false } = Astro.props;
---
<section class:list={['section', alt && 'section--alt']} id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section__head">
      <div>
        <h2 id={`${id}-title`}>{title}</h2>
        {intro && <p>{intro}</p>}
      </div>
      {moreHref && <a class="more" href={moreHref}>{moreLabel}</a>}
    </header>
    <slot />
  </div>
</section>
