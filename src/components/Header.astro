---
import Icon from './Icon.astro';
import { t, href, withBase, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  path: string;
  sections: { id: string; visible: boolean; title_fr?: string; title_en?: string }[];
  other: Lang;
  name: string;
}

const { lang, path, sections, other, name } = Astro.props;
const s = t(lang);
const pages: Record<string, string> = { news: 'news/', publications: 'publications/', blog: 'blog/' };
const navIds = ['about', 'research', 'projects', 'publications', 'team', 'news', 'blog', 'teaching', 'contact'];
const items = sections
  .filter((sec) => sec.visible && navIds.includes(sec.id))
  .sort((a, b) => navIds.indexOf(a.id) - navIds.indexOf(b.id))
  .map((sec) => ({
    id: sec.id,
    label: (lang === 'fr' ? sec.title_fr : sec.title_en) || sec.title_fr || sec.id,
    href: pages[sec.id] ? href(lang, pages[sec.id]) : `${href(lang)}#${sec.id}`,
    current: !!pages[sec.id] && path.startsWith(pages[sec.id]),
  }));
const parts = String(name).trim().split(/\s+/);
const last = parts.pop();
const first = parts.join(' ');
---
<header class="site-header">
  <a class="skip" href="#main">{s.skip}</a>
  <div class="wrap site-header__bar">
    <a class="brand" href={href(lang)}>{first} <strong>{last}</strong></a>
    <nav class="site-nav" aria-label={s.nav_label}>
      <ul>
        {items.map((item) => (
          <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <a class="icon-btn" href={withBase(localePath(other, path))} hreflang={other} lang={other} title={s.switch_lang} aria-label={s.switch_lang}>
        {s.switch_lang_short}
      </a>
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label={s.theme_toggle} title={s.theme_toggle}>
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
      <details class="mnav">
        <summary class="icon-btn" aria-label={s.menu}>
          <Icon name="menu" class="icon-menu" />
          <Icon name="close" class="icon-close" />
        </summary>
        <ul>
          {items.map((item) => (
            <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
    });
  });
  document.querySelectorAll<HTMLDetailsElement>('.mnav').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.removeAttribute('open')));
  });
</script>
