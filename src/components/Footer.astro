---
import Icon from './Icon.astro';
import { t, href, withBase, formatDate, pick, type Lang } from '../lib/i18n';
import { getSite } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const site = getSite();
const links: { label: string; url: string }[] = (site.links || []).filter((l: any) => l?.url);
const built = new Date().toISOString().slice(0, 10);
const year = built.slice(0, 4);
---
<footer class="site-footer" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-id">
        <h2 id="contact-title">{s.contact_title}</h2>
        <p class="footer-id__name">{site.name}</p>
        <p>{pick(site, 'title', lang)}</p>
        <p>{pick(site, 'affiliation', lang)}</p>
      </div>
      <ul class="contact-list">
        {site.email && (
          <li><span class="ic"><Icon name="email" /></span><span><span class="label">{s.email}</span><a class="value" href={`mailto:${site.email}`}>{site.email}</a></span></li>
        )}
        {site.phone && (
          <li><span class="ic"><Icon name="phone" /></span><span><span class="label">{s.phone}</span><a class="value" href={`tel:${String(site.phone).replace(/\s+/g, '')}`}>{site.phone}</a></span></li>
        )}
        {pick(site, 'address', lang) && (
          <li><span class="ic"><Icon name="pin" /></span><span><span class="label">{s.address}</span><span class="value">{pick(site, 'address', lang)}</span></span></li>
        )}
        {site.office && (
          <li><span class="ic"><Icon name="building" /></span><span><span class="label">{s.office}</span><span class="value">{site.office}</span></span></li>
        )}
      </ul>
      {links.length > 0 && (
        <div>
          <h3 class="profiles-title">{s.profiles}</h3>
          <ul class="profiles-list">
            {links.map((l) => <li><a href={l.url} rel="noopener me"><Icon name="external" />{l.label}</a></li>)}
          </ul>
        </div>
      )}
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.name} · {s.updated} {formatDate(built, lang)}</p>
      <ul aria-label={s.footer_links}>
        <li><a href={href(lang, 'publications/')}>{s.publications}</a></li>
        <li><a href={href(lang, 'news/')}>{s.page_news_title}</a></li>
        <li><a href="#main">{s.back_to_top} ↑</a></li>
        <li><a href={withBase('/admin/')} rel="nofollow">{s.edit}</a></li>
      </ul>
    </div>
  </div>
</footer>
